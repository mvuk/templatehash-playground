#!/bin/sh
# templatehash-playground bootstrap.
#
# Goal: get THIS machine to "Nix works, with flakes" doing the LEAST necessary,
# then launch a playground product. Safe to re-run (idempotent).
#
# Design rule: prefer per-command flags over mutating anyone's system config.
# We never edit /etc/nix or ~/.config/nix, and we never run an installer on NixOS.
#
# For LLM agents: AGENTS.md documents this same readiness ladder + recovery paths.
# Usage:  ./playground [product]      (default product: bark-templatehash)

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
FLAKE_REF="path:${SCRIPT_DIR}"
XFEAT="--extra-experimental-features"
FEATURES="nix-command flakes"

APP="${1:-default}"
[ "$#" -gt 0 ] && shift || true

say()  { printf '\033[1;36m▶ %s\033[0m\n'  "$*" >&2; }
warn() { printf '\033[1;33m! %s\033[0m\n'  "$*" >&2; }
err()  { printf '\033[1;31m✗ %s\033[0m\n'  "$*" >&2; }

have()    { command -v "$1" >/dev/null 2>&1; }
is_nixos() { [ -e /etc/NIXOS ] || [ -d /run/current-system ]; }

# If nix is installed but not on PATH (fresh install / non-login shell), source it.
source_nix_profile() {
  for f in \
    "$HOME/.nix-profile/etc/profile.d/nix.sh" \
    /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh \
    /nix/var/nix/profiles/default/etc/profile.d/nix.sh; do
    # shellcheck disable=SC1090
    [ -e "$f" ] && . "$f" && return 0
  done
  return 1
}

# "Working nicely" = nix runs AND can evaluate with flakes on.
nix_works() {
  have nix || return 1
  nix "$XFEAT" "$FEATURES" eval --raw --expr '"ok"' >/dev/null 2>&1
}

install_nix() {
  if is_nixos; then
    err "On NixOS but Nix isn't usable. Add this to your configuration.nix and rebuild:"
    err '    nix.settings.experimental-features = [ "nix-command" "flakes" ];'
    exit 1
  fi
  have curl || { err "curl is required to install Nix."; exit 1; }
  say "Installing Nix (Determinate Systems installer — will ask for sudo once)…"
  curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix \
    | sh -s -- install --no-confirm
  source_nix_profile || true
}

# ---- readiness ladder -------------------------------------------------------
have nix || source_nix_profile || true

if nix_works; then
  say "Nix is ready (flakes enabled)."
elif have nix; then
  err "Nix is installed but not functioning (daemon down, or too old for flakes?)."
  err "See AGENTS.md § 'Nix present but broken'."
  exit 1
else
  warn "No Nix found on this machine."
  install_nix
  nix_works || { err "Nix installed but still not working — see AGENTS.md."; exit 1; }
  say "Nix installed and ready."
fi

say "Launching product: ${APP}"
exec nix "$XFEAT" "$FEATURES" --accept-flake-config run "${FLAKE_REF}#${APP}" -- "$@"
