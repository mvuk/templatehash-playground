#!/bin/sh
# templatehash-playground bootstrap.
#
# Goal: get THIS machine to "Nix works, with flakes" doing the LEAST necessary,
# then launch a playground product. Safe to re-run (idempotent). Works on Linux
# and macOS.
#
# Design rules:
#   * prefer per-command flags over mutating anyone's system config
#     (we never edit /etc/nix or ~/.config/nix)
#   * never run a Nix installer on NixOS
#   * if we can't install Nix (no sudo / headless), fall back to the prebuilt
#     Docker image so the playground still runs
#
# For LLM agents: AGENTS.md documents this same readiness ladder + recovery paths.
# Usage:  ./playground [product]      (default product: the status dashboard)

set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
FLAKE_REF="path:${SCRIPT_DIR}"
XFEAT="--extra-experimental-features"
FEATURES="nix-command flakes"
DOCKER_IMAGE="${PLAYGROUND_IMAGE:-ghcr.io/mvuk/templatehash-playground:latest}"
PORT="${PLAYGROUND_PORT:-4848}"

APP="${1:-default}"
[ "$#" -gt 0 ] && shift || true

say()  { printf '\033[1;36m▶ %s\033[0m\n'  "$*" >&2; }
warn() { printf '\033[1;33m! %s\033[0m\n'  "$*" >&2; }
err()  { printf '\033[1;31m✗ %s\033[0m\n'  "$*" >&2; }

have()     { command -v "$1" >/dev/null 2>&1; }
is_nixos() { [ -e /etc/NIXOS ] || [ -d /run/current-system ]; }
has_docker() { have docker && docker info >/dev/null 2>&1; }
can_sudo() { [ "$(id -u)" = 0 ] || sudo -n true >/dev/null 2>&1; }

# If nix is installed but not on PATH (fresh install / non-login shell), source it.
# Covers both the Determinate and upstream installers, Linux and macOS.
source_nix_profile() {
  for f in \
    "$HOME/.nix-profile/etc/profile.d/nix.sh" \
    /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh \
    /nix/var/nix/profiles/default/etc/profile.d/nix.sh; do
    # shellcheck disable=SC1090
    [ -e "$f" ] && . "$f" && return 0
  done
  return 1
}

# "Working nicely" = nix runs AND can evaluate with flakes on.
nix_works() {
  have nix || return 1
  nix "$XFEAT" "$FEATURES" eval --raw --expr '"ok"' >/dev/null 2>&1
}

install_nix() {
  if is_nixos; then
    err "On NixOS but Nix isn't usable. Add this to configuration.nix and rebuild:"
    err '    nix.settings.experimental-features = [ "nix-command" "flakes" ];'
    return 1
  fi
  have curl || { err "curl is required to install Nix."; return 1; }
  if [ "$(id -u)" != 0 ] && ! sudo -n true >/dev/null 2>&1; then
    warn "The Nix installer needs admin rights — you may be prompted for your password."
  fi
  say "Installing Nix (Determinate Systems installer)…"
  curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix \
    | sh -s -- install --no-confirm || return 1
  source_nix_profile || true
}

run_docker() {
  say "Using the prebuilt Docker image (no Nix needed): $DOCKER_IMAGE"
  say "Open http://localhost:${PORT} once it's up."
  exec docker run --rm -it -p "${PORT}:${PORT}" -e "PLAYGROUND_PORT=${PORT}" \
    "$DOCKER_IMAGE" "$APP" "$@"
}

# ---- readiness ladder -------------------------------------------------------
have nix || source_nix_profile || true

if nix_works; then
  say "Nix is ready (flakes enabled)."
elif have nix; then
  err "Nix is installed but not functioning (daemon down, or too old for flakes?)."
  err "See AGENTS.md § 'Nix present but broken'."
  exit 1
else
  warn "No Nix found on this machine."
  if is_nixos; then
    err "On NixOS without a usable nix — enable experimental-features and rebuild (see AGENTS.md)."
    exit 1
  fi
  # Preferred: install Nix (native path) when we can get admin rights or a human
  # is present to answer the sudo prompt. Otherwise fall back to Docker.
  if can_sudo || [ -t 0 ]; then
    if install_nix && nix_works; then
      say "Nix installed and ready."
    elif has_docker; then
      warn "Nix install didn't complete — falling back to Docker."
      run_docker "$@"
    else
      err "Couldn't install Nix, and Docker isn't available. See AGENTS.md."
      exit 1
    fi
  elif has_docker; then
    run_docker "$@"
  else
    err "No Nix, no admin rights to install it, and no Docker."
    err "Either install Docker, or install Nix yourself (needs admin) and re-run. See AGENTS.md."
    exit 1
  fi
fi

say "Launching product: ${APP}"
exec nix "$XFEAT" "$FEATURES" --accept-flake-config run "${FLAKE_REF}#${APP}" -- "$@"
